# backend service base url, prod environment
# 注意:接口 path 本身已含 /api/v1 前缀,这里只填站点根地址(否则拼出 /api/api/v1 404)
# 经同域 Nginx 反代 /api/ -> 127.0.0.1:8081
VITE_SERVICE_BASE_URL=https://www.yzhzhaohao.cn

# admin 部署在官网同域的 /admin/ 子路径
VITE_BASE_URL=/admin/

# other backend service base url, prod environment
VITE_OTHER_SERVICE_BASE_URL= `{
  "demo": "http://localhost:9529"
}`
