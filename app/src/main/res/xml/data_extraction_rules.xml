<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+ 备份/换机传输规则:尽管 allowBackup=false,部分 ROM 的 D2D 迁移仍会读取本规则。
  排除全部 SharedPreferences(内含 JWT 与登录态),避免 token 被导出到云端或其他设备。
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
